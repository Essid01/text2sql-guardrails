# Copy to .env and fill in. Never commit .env.

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=
# Cheapest current Claude model (verified in the official model list, 2026-11).
# No date suffix. See https://docs.claude.com/en/docs/about-claude/models
LLM_MODEL=claude-haiku-5-5
# Thinking depth / token spend: low | medium | high | xhigh | max. "low" = cheapest.
LLM_EFFORT=low
# Thinking tokens count toward this cap.
LLM_MAX_TOKENS=4096
# Cache LLM responses locally (SQLite) to avoid paying twice for identical calls.
LLM_CACHE_ENABLED=true
# USD per million tokens, for the cost report (Haiku 5.5, prompts <= 100K tokens).
LLM_PRICE_INPUT_PER_MTOK=0.10
LLM_PRICE_OUTPUT_PER_MTOK=0.50

# --- Database ---
POSTGRES_USER=text2sql
POSTGRES_PASSWORD=text2sql
POSTGRES_DB=retail
POSTGRES_PORT=5432
# Admin connection: schema creation, seeding, app tables.
DATABASE_URL=postgresql+psycopg://text2sql:text2sql@localhost:5432/retail
# Read-only role that executes generated SQL (SELECT only, read-only transactions).
# Created/updated by `python -m text2sql.db.seed`. Change the password outside local dev.
READONLY_DATABASE_URL=postgresql+psycopg://text2sql_reader:change-me-reader@localhost:5432/retail
QUERY_TIMEOUT_MS=5000
# Refuse queries whose EXPLAIN cost exceeds this (normal analytics: 300-4,000).
MAX_QUERY_COST=100000
MAX_RESULT_ROWS=1000

# --- Schema retrieval ---
# Unset = full schema in the prompt (default). Set e.g. 4 to keep only the 4 most
# similar tables (+ FK bridge tables). Requires: pip install -e ".[embeddings]"
# SCHEMA_TOP_K=4
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

LOG_LEVEL=INFO
AUDIT_LOG_PATH=logs/audit.jsonl
